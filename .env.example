# Next.js 15 Environment Variables Example
# Copy this file to .env.local and populate with your actual keys

# Supabase Auth and Database Connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM Providers (for Document Ingestion, Multi-Agent Reasoning, and Chat)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=gemini # Options: gemini, anthropic, openai
